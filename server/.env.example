NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/linguist-ai-flow
JWT_SECRET=linguist-ai-flow-dev-secret-change-in-production
ALLOWED_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ─── Auth cookie ──────────────────────────────────────────────────────────
# Refresh cookie'ning SameSite qiymati. Default: production'da `none`
# (frontend va backend turli saytlarda). Ikkalasi bitta sayt ostiga
# olingach (app.domen.uz + api.domen.uz yoki Vercel proxy) `lax` qo'ying:
# Safari cookie'ni bloklamaydi va CSRF'dan himoya kuchayadi.
# COOKIE_SAMESITE=lax
# Subdomenlar orasida ulashish kerak bo'lsa (odatda kerak emas):
# COOKIE_DOMAIN=.domen.uz
# Backend oldida nechta proksi bor. Vercel proxy → Cloudflare → Render = 4
# (/health dagi forwardedFor zanjiridan sanang; clientIp sizning IP'ingiz bo'lsin).
# Noto'g'ri bo'lsa rate limit hamma foydalanuvchini bitta IP deb sanaydi.
# TRUST_PROXY_HOPS=1

# Vercel preview URL'lari har branchda o'zgaradi va ularni qo'lda
# ALLOWED_ORIGIN ga qo'shish unutiladi. Bu shablon ularni avtomatik
# qabul qiladi.
#
# XAVFSIZLIK: shablon ^ va $ bilan bog'lanishi SHART va begona manzilga
# mos kelmasligi kerak — aks holda server uni e'tiborsiz qoldiradi va
# logga xato yozadi. Loyiha nomingizga moslang.
# ALLOWED_ORIGIN_PATTERN=^https://<loyiha>-git-[a-z0-9-]+-<jamoa>\.vercel\.app$

# ─── AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Ishlab chiqish paytidagi kunlik AI limiti (production'da tarif bo'yicha)
# DEV_AI_LIMIT=500

# ─── Vaqt zonasi ──────────────────────────────────────────────────────────
# Foydalanuvchi zonasi noma'lum bo'lganda ishlatiladi.
# Streak va kunlik reja shunga qarab hisoblanadi — UTC EMAS.
DEFAULT_TIMEZONE=Asia/Tashkent

# ─── Pochta (parolni tiklash) ─────────────────────────────────────────────
# Sozlanmasa xat konsolga chiqadi va oqim to'xtamaydi (lokal ishlab chiqish).
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MAIL_FROM=Linguist AI <no-reply@sizning-domeningiz.uz>

# ─── Kunlik eslatmalar ────────────────────────────────────────────────────
# Eslatmalar foydalanuvchining MAHALLIY soatida yuboriladi, shuning uchun
# cron'ni soatiga bir marta chaqirish yetarli:
#   curl -X POST https://<backend>/api/notifications/run \
#        -H "x-cron-secret: $CRON_SECRET"
CRON_SECRET=
# Bitta yugurishda yuboriladigan maksimal xat soni
# REMINDER_MAX_PER_RUN=500
# Tashqi cron o'rniga ichki interval (Render bepul tarifida ishonchsiz —
# servis bo'sh turishda o'chadi va interval to'xtaydi)
# ENABLE_INTERNAL_CRON=false

# ─── Push bildirishnoma (Web Push) ────────────────────────────────────────
# Kalitlarni generatsiya qilish:  npm run push:keys
# DIQQAT: kalitlar BIR MARTA generatsiya qilinadi. Ularni almashtirish
# barcha mavjud obunalarni bekor qiladi va foydalanuvchilar qayta ruxsat
# berishi kerak bo'ladi.
# Kalitlar yo'q bo'lsa push jimgina o'chiq qoladi va eslatma email orqali ketadi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@linguist.uz

# ─── Telegram bot (eslatmalarning asosiy kanali) ──────────────────────────
# 1) @BotFather → /newbot → tokenni shu yerga yozing.
# 2) Deploydan keyin bir marta:  npm run telegram:webhook -- https://<backend>
# Eslatma kanallari tartibi: Telegram → push → email (faqat bittasi).
# Token yo'q bo'lsa Telegram jimgina o'chiq qoladi.
TELEGRAM_BOT_TOKEN=
# @ belgisisiz, masalan: linguist_uz_bot
TELEGRAM_BOT_USERNAME=
# Uzun tasodifiy satr (faqat A-Z a-z 0-9 _ -). Webhook so'rovlari shu bilan tekshiriladi.
TELEGRAM_WEBHOOK_SECRET=
# Lokal ishlab chiqish: webhook o'rniga long polling (production'da ishlamaydi)
# TELEGRAM_POLLING=true

# ─── Stripe ───────────────────────────────────────────────────────────────
# Diqqat: Stripe O'zbekiston kartalarini qabul qilmaydi.
# Mahalliy bozor uchun Payme/Click integratsiyasi hali qilinmagan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# STRIPE_API_VERSION=2025-10-29.clover
