NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/linguist-ai-flow
JWT_SECRET=linguist-ai-flow-dev-secret-change-in-production
ALLOWED_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ─── AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Ishlab chiqish paytidagi kunlik AI limiti (production'da tarif bo'yicha)
# DEV_AI_LIMIT=500

# ─── Vaqt zonasi ──────────────────────────────────────────────────────────
# Foydalanuvchi zonasi noma'lum bo'lganda ishlatiladi.
# Streak va kunlik reja shunga qarab hisoblanadi — UTC EMAS.
DEFAULT_TIMEZONE=Asia/Tashkent

# ─── Pochta (parolni tiklash) ─────────────────────────────────────────────
# Sozlanmasa xat konsolga chiqadi va oqim to'xtamaydi (lokal ishlab chiqish).
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MAIL_FROM=Linguist AI <no-reply@sizning-domeningiz.uz>

# ─── Stripe ───────────────────────────────────────────────────────────────
# Diqqat: Stripe O'zbekiston kartalarini qabul qilmaydi.
# Mahalliy bozor uchun Payme/Click integratsiyasi hali qilinmagan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# STRIPE_API_VERSION=2025-10-29.clover
