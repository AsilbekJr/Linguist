# Local development: VITE_API_URL YOZMANG — /api so'rovlari Vite proxy orqali
# lokal backendga (127.0.0.1:5000) ketadi. Shunda telefondan ham ishlaydi.
# Backend boshqa portda bo'lsa: DEV_API_TARGET=http://127.0.0.1:5001 npm run dev

# Production (Vercel) — majburiy:
# VITE_API_URL=https://linguist-backend.onrender.com

# ─── Analitika (ixtiyoriy) ────────────────────────────────────────────────
# Kalit yo'q bo'lsa hech narsa yuborilmaydi va ilova normal ishlaydi.
# SDK ishlatilmaydi — PostHog'ning HTTP capture endpointi to'g'ridan-to'g'ri
# chaqiriladi, shuning uchun bundle hajmi oshmaydi.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
